# TR3NT runs as a LOCAL daemon: bound to loopback, single user, no authentication.
# See docs/adr/001-local-daemon.md before changing HOST.
HOST=127.0.0.1
PORT=3777

DATABASE_URL=postgres://tr3nt:tr3nt@localhost:5432/tr3nt

# Hard ceiling for everything the Context Engine sends to the model (Phase 3).
# Deliberately far below Gemini's window: the whole point is to not fill it.
TR3NT_CONTEXT_BUDGET_TOKENS=12000

# Phase 2. Never commit a real key; .env is gitignored.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
